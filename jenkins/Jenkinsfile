pipeline {
    agent any

    triggers {
        githubPush()
    }

    tools {
        nodejs 'NODE-JS22'
    }

    environment {
        IMAGE_NAME      = "yashdevops123/hotstar-clone"
        IMAGE_TAG       = "${BUILD_NUMBER}"

        ECR_REGISTRY    = "634737373070.dkr.ecr.ap-south-1.amazonaws.com"
        ECR_REPOSITORY  = "hotstar-clone"

        SCANNER_HOME    = tool 'sonar-scanner'
    }

    stages {

        // ==================================================
        // 1. CHECKOUT
        // ==================================================

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ==================================================
        // 2. CHECK VERSIONS
        // ==================================================

        stage('Check Versions') {
            steps {
                sh '''
                    echo "=== Node.js ==="
                    node --version

                    echo "=== NPM ==="
                    npm --version

                    echo "=== Docker ==="
                    docker --version

                    echo "=== AWS CLI ==="
                    aws --version

                    echo "=== Trivy ==="
                    trivy --version
                '''
            }
        }

        // ==================================================
        // 3. INSTALL DEPENDENCIES
        // ==================================================

        stage('Install Dependencies') {
            steps {
                dir('app') {
                    sh '''
                        echo "Installing application dependencies..."

                        npm ci --prefer-offline

                        echo "Dependencies installed successfully."
                    '''
                }
            }
        }

        // ==================================================
        // 4. SONARQUBE SCAN
        // ==================================================

        stage('SonarQube Scan') {
            steps {
                withSonarQubeEnv('SonarQube') {

                    sh '''
                        echo "SonarQube Host: $SONAR_HOST_URL"

                        if [ -n "$SONAR_AUTH_TOKEN" ]; then
                            echo "SONAR_TOKEN_PRESENT=YES"
                        else
                            echo "SONAR_TOKEN_PRESENT=NO"
                        fi
                    '''

                    dir('app') {
                        sh """
                            echo "Running SonarQube scan..."

                            ${SCANNER_HOME}/bin/sonar-scanner \
                                -Dsonar.projectKey=hotstar-clone \
                                -Dsonar.projectName=hotstar-clone \
                                -Dsonar.sources=src
                        """
                    }
                }
            }
        }

        // ==================================================
        // 5. OWASP DEPENDENCY CHECK
        // ==================================================

        stage('OWASP Dependency Check') {
            steps {
                sh '''
                    set -e

                    /opt/dependency-check/bin/dependency-check.sh \
                        --project "Hotstar Clone" \
                        --scan app/package.json \
                        --scan app/package-lock.json \
                        --format HTML \
                        --out dependency-check-report \
                        --disableYarnAudit \
                        --disableAssembly \
                        --noupdate \
                        --failOnCVSS 9 \
                        --data /opt/dependency-check/data
                 '''
            }
        }

        // ==================================================
        // 6. PUBLISH OWASP REPORT
        // ==================================================

        stage('Publish OWASP Report') {
            steps {
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'dependency-check-report',
                    reportFiles: 'dependency-check-report.html',
                    reportName: 'OWASP Dependency-Check Report'
                ])
            }
        }

        // ==================================================
        // 7. BUILD REACT APPLICATION
        // ==================================================

        stage('Build React App') {
            steps {
                dir('app') {
                    sh '''
                        echo "Building React application..."

                        CI=false npm run build
                    '''
                }
            }
        }

        // ==================================================
        // 8. DOCKER BUILD
        // ==================================================

        stage('Docker Build') {
            steps {
                sh '''
                    echo "======================================"
                    echo "Building Docker image"
                    echo "======================================"

                    docker build \
                        -t "$IMAGE_NAME:$IMAGE_TAG" \
                        -f docker/Dockerfile .

                    echo "Docker image created successfully."

                    docker images "$IMAGE_NAME:$IMAGE_TAG"
                '''
            }
        }

        // ==================================================
        // 9. TRIVY IMAGE SCAN
        // ==================================================

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    echo "======================================"
                    echo "Scanning Docker image with Trivy"
                    echo "======================================"

                    trivy image \
                        --timeout 10m \
                        --scanners vuln \
                        --severity CRITICAL \
                        --ignore-unfixed \
                        --exit-code 1 \
                        "$IMAGE_NAME:$IMAGE_TAG"

                    echo "Trivy scan completed successfully."
                '''
            }
        }

        // ==================================================
        // 10. VERIFY AWS CREDENTIALS
        // ==================================================

        stage('Verify AWS Credentials') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-ecr']
                ]) {

                    sh '''
                        echo "======================================"
                        echo "Testing AWS credentials"
                        echo "======================================"

                        aws sts get-caller-identity

                        echo "Testing ECR access..."

                        aws ecr describe-repositories \
                            --repository-names "$ECR_REPOSITORY" \
                            --region ap-south-1

                        echo "AWS/ECR verification successful."
                    '''
                }
            }
        }

        // ==================================================
        // 11. PUSH IMAGE TO ECR
        // ==================================================

        stage('Push Image to ECR') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-ecr']
                ]) {

                    sh '''
                        echo "======================================"
                        echo "Logging in to Amazon ECR"
                        echo "======================================"

                        aws ecr get-login-password \
                            --region ap-south-1 | \
                        docker login \
                            --username AWS \
                            --password-stdin "$ECR_REGISTRY"

                        echo "ECR login successful."

                        echo "Tagging image for ECR..."

                        docker tag \
                            "$IMAGE_NAME:$IMAGE_TAG" \
                            "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"

                        echo "Pushing image to ECR..."

                        docker push \
                            "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"

                        echo "======================================"
                        echo "Image pushed successfully"
                        echo "======================================"

                        echo "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"
                    '''
                }
            }
        }

        // ==================================================
        // 12. UPDATE KUBERNETES MANIFEST
        // ==================================================

        stage('Deploy to EKS') {
    steps {
        withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws-ecr']
        ]) {
            sh '''
                aws eks update-kubeconfig \
                    --region ap-south-1 \
                    --name hotstar-eks

                kubectl apply -f kubernetes/

                kubectl rollout status \
                    deployment/hotstar-clone \
                    --timeout=5m
            '''
        }
    }
}

        // ==================================================
        // 13. COMMIT AND PUSH GITOPS CHANGE
        // ==================================================

        stage('Commit and Push GitOps Change') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "======================================"
                        echo "GitOps Commit Stage"
                        echo "======================================"

                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"

                        git add kubernetes/deployment.yaml

                        if git diff --cached --quiet; then
                            echo "No Kubernetes manifest changes detected."
                        else
                            echo "Creating GitOps commit..."

                            git commit \
                                -m "[ci-gitops] Update Hotstar image to ${BUILD_NUMBER}"

                            echo "Pushing GitOps change to GitHub..."

                            git push \
                                https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/useryash01/hotstar-clone-devsecops.git \
                                HEAD:main

                            echo "GitOps change pushed successfully."
                        fi
                    '''
                }
            }
        }
    }

    // ==================================================
    // POST ACTIONS
    // ==================================================

    post {

        always {
            archiveArtifacts(
                artifacts: 'dependency-check-report/dependency-check-report.html',
                allowEmptyArchive: true
            )

            cleanWs()
        }

        success {
            echo "======================================"
            echo "Pipeline completed successfully."
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "Pipeline failed."
            echo "======================================"
        }
    }
}