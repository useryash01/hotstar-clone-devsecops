pipeline {
    agent any

    triggers {
        githubPush()
    }

    tools {
        nodejs 'NODE-JS22'
    }

    environment {
        IMAGE_NAME      = "yashdevops123/hotstar-clone"
        IMAGE_TAG       = "${BUILD_NUMBER}"
        ECR_REGISTRY    = "386963841514.dkr.ecr.ap-south-1.amazonaws.com"
        ECR_REPOSITORY  = "hotstar-clone"
        AWS_REGION      = "ap-south-1"
        EKS_CLUSTER     = "hotstar-eks"
        SCANNER_HOME    = tool 'sonar-scanner'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }


        stage('Check Versions') {
            steps {
                sh '''
                    set -eu
                    echo "=== Node.js ==="
                    node --version
                    echo "=== NPM ==="
                    npm --version
                    echo "=== Docker ==="
                    docker --version
                    echo "=== AWS CLI ==="
                    aws --version
                    echo "=== Trivy ==="
                    trivy --version
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('app') {
                    sh '''
                        set -eu
                        npm ci --prefer-offline
                    '''
                }
            }
        }

        stage('SonarQube Scan') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir('app') {
                        sh """
                            set -eu
                            "${SCANNER_HOME}/bin/sonar-scanner" \
                                -Dsonar.projectKey=hotstar-clone \
                                -Dsonar.projectName=hotstar-clone \
                                -Dsonar.sources=src
                        """
                    }
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                sh '''
                    set -eu
                    mkdir -p dependency-check-report

                    /opt/dependency-check/bin/dependency-check.sh \
                        --project "Hotstar Clone" \
                        --scan app/package.json \
                        --scan app/package-lock.json \
                        --format HTML \
                        --out dependency-check-report \
                        --disableYarnAudit \
                        --disableAssembly \
                        --noupdate \
                        --failOnCVSS 7.0 \
                        --data /opt/dependency-check/data
                '''
            }
        }

        stage('Publish OWASP Report') {
            steps {
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'dependency-check-report',
                    reportFiles: 'dependency-check-report.html',
                    reportName: 'OWASP Dependency-Check Report'
                ])
            }
        }

        stage('Build React App') {
            steps {
                dir('app') {
                    sh '''
                        set -eu
                        CI=false npm run build
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    set -eu
                    docker build \
                        -t "$IMAGE_NAME:$IMAGE_TAG" \
                        -f docker/Dockerfile .
                    docker images "$IMAGE_NAME:$IMAGE_TAG"
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    set -eu
                    trivy image \
                        --timeout 30m \
                        --scanners vuln \
                        --severity CRITICAL \
                        --ignore-unfixed \
                        --exit-code 1 \
                        "$IMAGE_NAME:$IMAGE_TAG"
                '''
            }
        }

        stage('Verify AWS Credentials') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-ecr']
                ]) {
                    sh '''
                        set -eu
                        set +x
                        aws sts get-caller-identity
                        aws ecr describe-repositories \
                            --repository-names "$ECR_REPOSITORY" \
                            --region "$AWS_REGION" \
                            --query 'repositories[0].repositoryUri' \
                            --output text
                    '''
                }
            }
        }

        stage('Push Image to ECR') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-ecr']
                ]) {
                    sh '''
                        set -eu
                        set +x

                        aws ecr get-login-password \
                            --region "$AWS_REGION" |
                        docker login \
                            --username AWS \
                            --password-stdin "$ECR_REGISTRY"

                        IMAGE_URI="$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"
                        docker tag "$IMAGE_NAME:$IMAGE_TAG" "$IMAGE_URI"
                        docker push "$IMAGE_URI"

                        echo "Pushed image: $IMAGE_URI"
                    '''
                }
            }
        }

        stage('Update and Push Deployment Manifest') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        IMAGE_URI="$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"

                        sed -i \
                          "s|image: .*hotstar-clone:.*|image: ${IMAGE_URI}|" \
                          kubernetes/deployment.yaml

                        echo "Manifest image:"
                        grep -n 'image:' kubernetes/deployment.yaml

                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"
                        git add kubernetes/deployment.yaml

                        if git diff --cached --quiet; then
                            echo "Deployment manifest already has this image."
                        else
                            git commit -m "ci: update Hotstar image to ${IMAGE_TAG}"

                            ASKPASS="$(mktemp)"
                            trap 'rm -f "$ASKPASS"' EXIT
                            cat > "$ASKPASS" <<'ASKPASS_SCRIPT'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\n' "$GIT_USERNAME" ;;
  *Password*) printf '%s\n' "$GIT_TOKEN" ;;
  *) exit 1 ;;
esac
ASKPASS_SCRIPT
                            chmod 700 "$ASKPASS"

                            GIT_ASKPASS="$ASKPASS" \
                            GIT_TERMINAL_PROMPT=0 \
                                git push origin HEAD:main
                        fi
                    '''
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-ecr']
                ]) {
                    sh '''
                        set -eu
                        set +x

                        aws eks update-kubeconfig \
                            --region "$AWS_REGION" \
                            --name "$EKS_CLUSTER"

                        # Apply only the application Deployment. Other
                        # resources such as Ingress and Secrets are untouched.
                        kubectl apply -f kubernetes/deployment.yaml

                        kubectl rollout status \
                            deployment/hotstar-clone \
                            --timeout=5m

                        echo "Deployed image:"
                        kubectl get deployment hotstar-clone \
                            -o jsonpath='{.spec.template.spec.containers[0].image}{"\n"}'
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'dependency-check-report/dependency-check-report.html',
                allowEmptyArchive: true
            )
            cleanWs()
        }

        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Review the stage logs above.'
        }
    }
}
